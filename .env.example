# ─── Vercel Environment Variables ───────────────────────────────────────────
# Add these in: Vercel Dashboard → Your Project → Settings → Environment Variables

# Supabase (backend — service role, NEVER exposed to browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT secret used to sign/verify auth tokens
JWT_SECRET=replace_with_a_long_random_secret

# ─── Frontend env vars (prefix VITE_ so Vite embeds them at build time) ─────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_AUTH_REDIRECT_URL=https://your-vercel-domain.vercel.app/auth/callback

# Leave VITE_API_URL empty in production — frontend will call /api on the same domain
VITE_API_URL=
